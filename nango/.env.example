# Copy to .env (git ignores it) and fill in.
# Encrypts the logins Nango stores. Make one with: openssl rand -base64 32
# Keep a copy somewhere safe: it can't be changed later, and without it the stored logins can't be read.
NANGO_ENCRYPTION_KEY=

# Dashboard login. true (default): sign up for a local account at http://localhost:3003 (it stays in
# this machine's database). false: no accounts; the dashboard opens for anyone on this machine.
FLAG_AUTH_ENABLED=true
